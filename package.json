{
  "name": "arete",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@arete/web",
    "dev:api": "turbo run dev --filter=@arete/api",
    "dev:mobile": "pnpm --filter @arete/mobile dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @arete/db generate",
    "db:migrate:dev": "pnpm --filter @arete/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @arete/db migrate:deploy",
    "db:seed": "pnpm --filter @arete/db seed"
  },
  "devDependencies": {
    "turbo": "2.11.5"
  }
}
